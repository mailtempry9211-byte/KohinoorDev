<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Top icon & title -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_notification_minimal"
        android:contentDescription="Security Monitor"
        android:layout_marginTop="24dp"
        app:tint="@color/indigo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection &amp; Monitoring Status"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:layout_marginTop="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusIndicatorDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/shape_dot" />

            <TextView
                android:id="@+id/statusTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Checking status…"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="14dp" />

        <!-- Detail rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Relay Service"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusServiceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Running"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dashboard Target"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusTargetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.x.x"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active Sensors"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusSensorsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standby"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Mode"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusDeviceModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard (Unmanaged)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Transparent Info note -->
    <TextView
        android:id="@+id/statusExplanationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone Link Hub runs as a foreground service for authorized security monitoring and camera feeds. Settings access can be PIN-protected by the device owner."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/statusOpenSettingsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App Settings"
        android:backgroundTint="@color/indigo"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/statusReconnectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reconnect Now"
        android:backgroundTint="@color/surface_variant"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

</LinearLayout>

