<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ============================================================== -->
    <!-- LAYER 1: POCO / MIUI STYLE HOMESCREEN DESKTOP                  -->
    <!-- ============================================================== -->
    <RelativeLayout
        android:id="@+id/desktopContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true">

        <!-- Top Section: Pixel At-a-Glance Live Clock & Weather & Menu Pill -->
        <LinearLayout
            android:id="@+id/atAGlanceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Pixel At-a-Glance Live Date & Weather -->
                <LinearLayout
                    android:id="@+id/pixelAtAGlanceContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextClock
                            android:id="@+id/launcherDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:format12Hour="EEEE, MMM d"
                            android:format24Hour="EEEE, MMM d"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1.5"
                            android:shadowDy="1.5"
                            android:shadowRadius="4.0"
                            android:textColor="#FFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <!-- Weather Icon & Temp -->
                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="Weather"
                            android:src="@drawable/ic_weather_partly_cloudy" />

                        <TextView
                            android:id="@+id/tvWeatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1.5"
                            android:shadowDy="1.5"
                            android:shadowRadius="4.0"
                            android:text="28°C"
                            android:textColor="#F3F4F6"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <!-- Optional Secondary Subtitle / Reminder / Good Morning -->
                    <TextView
                        android:id="@+id/tvAtAGlanceSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1.0"
                        android:shadowDy="1.0"
                        android:shadowRadius="3.0"
                        android:text="Partly cloudy • Have a great day!"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 3-Dot Discreet Live Connection Status & Launcher Menu Pill -->
                <LinearLayout
                    android:id="@+id/statusDotsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_status_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/shape_dot_dim" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/shape_dot_dim" />

                    <View
                        android:id="@+id/dot3"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/shape_dot_dim" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="7dp"
                        android:contentDescription="Settings Menu"
                        android:src="@android:drawable/ic_menu_more"
                        android:tint="#D1D5DB" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Shinchan Anime Live Weather & Clock Card (Matching Image 3 from user) -->
        <FrameLayout
            android:id="@+id/shinchanWidgetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/atAGlanceSection"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <include
                android:id="@+id/shinchanWidgetCard"
                layout="@layout/widget_clock"
                android:layout_width="match_parent"
                android:layout_height="145dp" />
        </FrameLayout>

        <!-- Center Section: Desktop Scrollable App Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/desktopAppsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/shinchanWidgetContainer"
            android:layout_above="@id/bottomDockSection"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <!-- Bottom Section: Fixed Dock + Page Indicator + Search Pill -->
        <LinearLayout
            android:id="@+id/bottomDockSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <!-- Home Screen Page Indicator Dots (• • •) -->
            <LinearLayout
                android:id="@+id/pageIndicatorLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pageDot1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/shape_dot_green" />

                <View
                    android:id="@+id/pageDot2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/shape_dot_dim" />
            </LinearLayout>

            <!-- Fixed Pixel Bottom Favorite Dock (Phone, Messages, Chrome, Camera, Play Store) -->
            <LinearLayout
                android:id="@+id/dockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dock"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dockRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- Swipe up for all apps indicator -->
            <LinearLayout
                android:id="@+id/swipeUpIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Swipe Up"
                    android:src="@drawable/ic_chevron_up" />
            </LinearLayout>

            <!-- Authentic Google Pixel Search Pill -->
            <LinearLayout
                android:id="@+id/searchPillBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_pixel_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Google 4-Color 'G' Logo -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Google"
                    android:src="@drawable/ic_pixel_g" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Search apps &amp; web..."
                    android:textColor="#E5E7EB"
                    android:textSize="14sp" />

                <!-- Pixel Assistant Mic -->
                <ImageView
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Voice Search"
                    android:src="@drawable/ic_pixel_mic" />

                <!-- Google Lens -->
                <ImageView
                    android:id="@+id/btnLensSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Google Lens"
                    android:src="@drawable/ic_pixel_lens" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- ============================================================== -->
    <!-- LAYER 2: POCO STYLE SLIDING APP DRAWER WITH CATEGORY TABS      -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/appDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Drawer Top Bar: Search Input & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_pixel_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#FFFFFF" />

            <EditText
                android:id="@+id/drawerSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search all apps..."
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnCloseDrawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close Drawer"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#9CA3AF" />
        </LinearLayout>

        <!-- POCO Horizontal Category Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoriesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabCommunication"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Communication"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSocial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Social &amp; Media"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Tools"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Games"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Drawer All Apps Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerAppsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />
    </LinearLayout>

</FrameLayout>
