<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FF0B1120"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Watch / Clock Dial Icon -->
    <ImageView
        android:id="@+id/notif_watch_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_watch_clock"
        android:contentDescription="Watch Clock"
        android:layout_gravity="center_vertical" />

    <!-- Center Content: 3 Dots + Status Text + Subtext -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <!-- Dots Row + Connection Status Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Red Dot -->
            <ImageView
                android:id="@+id/notif_dot_red"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/shape_dot_dim" />

            <!-- Yellow Dot -->
            <ImageView
                android:id="@+id/notif_dot_yellow"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/shape_dot_dim" />

            <!-- Green Dot -->
            <ImageView
                android:id="@+id/notif_dot_green"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/shape_dot_green" />

            <!-- Status Title -->
            <TextView
                android:id="@+id/notif_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFF1F5F9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Connected" />
        </LinearLayout>

        <!-- Subtext: Device / Telemetry / Server IP -->
        <TextView
            android:id="@+id/notif_sub_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:text="PhoneLink Hub · 🔋 85%" />
    </LinearLayout>

    <!-- Right Side: Live Hardware TextClock -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end|center_vertical">

        <TextClock
            android:id="@+id/notif_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="#FF2DD4BF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF64748B"
            android:textSize="10sp"
            android:text="LIVE TICK" />
    </LinearLayout>
</LinearLayout>
