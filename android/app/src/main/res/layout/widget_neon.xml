<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetNeonContainer"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@drawable/bg_grid_card_selected"
    android:padding="16dp">

    <!-- Big Cyber Cyan Clock -->
    <TextClock
        android:id="@+id/neonClockTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fontFamily="sans-serif-black"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:textColor="#38BDF8"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- AM/PM & Seconds Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/neonClockTime"
        android:layout_alignTop="@id/neonClockTime"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/neonClockAmPm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="#818CF8"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="#34D399"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side: Weather Degree & Condition -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/neonTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="25°C"
            android:textColor="#F3F4F6"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/neonCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛅ Clear"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Row: Day & Date -->
    <TextClock
        android:id="@+id/neonDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

</RelativeLayout>

