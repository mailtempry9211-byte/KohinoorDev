<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top AMOLED Dark Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title & Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PhoneLink Parent Hub"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Local Server Active • Port 5000"
                    android:textColor="@color/emerald"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Mode Switch Button -->
            <Button
                android:id="@+id/btnModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Remote URL"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/surface_card"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

        <!-- Address Bar with Copy Action -->
        <LinearLayout
            android:id="@+id/addressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#161e2e">

            <TextView
                android:id="@+id/tvServerAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="http://127.0.0.1:5000"
                android:textColor="@color/cyan"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCopyAddress"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Copy IP"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/indigo"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.Material3.Button" />

            <Button
                android:id="@+id/btnRefreshWeb"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Reload"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/surface"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

    </LinearLayout>

    <!-- Fullscreen React Dashboard WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background" />

</LinearLayout>
