<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Ultra-Compact AMOLED Dark Status Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical"
        android:elevation="3dp">

        <!-- Clickable Address / Status Chip -->
        <LinearLayout
            android:id="@+id/statusChip"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:paddingHorizontal="8dp"
            android:backgroundTint="#161e2e"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvServerStatusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvServerAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="http://127.0.0.1:5000"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <!-- Copy Address Button -->
        <Button
            android:id="@+id/btnCopyAddress"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Copy"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/indigo"
            android:textAllCaps="false"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            style="@style/Widget.Material3.Button" />

        <!-- Ngrok / Out-of-Network Tunnel Button -->
        <Button
            android:id="@+id/btnTunnelSettings"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="☁️ Tunnel"
            android:textSize="10sp"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/surface_card"
            android:textAllCaps="false"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="56dp"
            android:paddingHorizontal="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Mode Switch Button (Local/Remote) -->
        <Button
            android:id="@+id/btnModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Remote"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface"
            android:textAllCaps="false"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:paddingHorizontal="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Refresh Button -->
        <Button
            android:id="@+id/btnRefreshWeb"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:text="🔄"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/surface_card"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            style="@style/Widget.Material3.Button.TonalButton" />

    </LinearLayout>

    <!-- Fullscreen React Dashboard WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background" />

</LinearLayout>

