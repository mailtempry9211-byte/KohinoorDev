{
  "name": "phonelink-hub",
  "version": "1.0.0",
  "description": "PhoneLink Hub - Dedicated Standalone Parental Control & Telemetry Suite",
  "author": "PhoneLink",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:dashboard": "npm run --prefix dashboard build",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.phonelink.hub",
    "productName": "PhoneLink Hub",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhoneLink Hub"
    },
    "files": [
      "electron/**/*",
      "dashboard/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/db.json"
        ]
      },
      {
        "from": "license-portal",
        "to": "license-portal",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": false
  }
}

